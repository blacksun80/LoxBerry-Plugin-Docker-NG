#!/bin/bash

# LoxBerry uninstall script for the Docker NG plugin.
#
# This file lives in  uninstall/uninstall  and is executed AS ROOT at the
# very end of the plugin uninstallation (NOT on update).
#
# GRUNDREGEL: Dieses Skript entfernt NUR, was Docker NG selbst angelegt hat -
# den Portainer-Container und dessen Datenverzeichnis. Die Docker-Engine
# bleibt IMMER stehen.
#
# Warum die Engine nicht mit entfernt wird:
#
# Frueher hat dieses Skript kompromisslos "apt-get purge docker-ce
# docker-ce-cli containerd.io ..." plus "rm -rf /var/lib/docker" ausgefuehrt,
# in der Annahme, Docker NG sei der alleinige Eigentuemer von Docker. Diese
# Annahme ist falsch: andere LoxBerry-Plugins installieren Docker ebenfalls
# selbst, wenn es fehlt, und betreiben eigene Container darin - so etwa
# AudioServer4Home, was vorher niemandem bewusst war.
#
# Der Schaden entstand typischerweise im Nachgang einer FEHLGESCHLAGENEN
# Installation. Nachgestellt auf einer Testmaschine mit laufendem
# AudioServer4Home:
#
#   1. postroot.sh bricht mit "exit 2" ab, weil Portainers Port 9000 belegt
#      ist (sonn-core laeuft mit network_mode: host und hoert selbst auf 9000).
#   2. LoxBerry meldet "Installation cannot be continued" - zerstoert dabei
#      aber nichts. Ein exit 2 fuehrt NICHT dazu, dass dieses Skript laeuft
#      (plugininstall.pl, sub fail: raeumt nur Temp-Dateien auf und beendet).
#   3. Das Plugin bleibt trotz Fehlschlag in der Pluginliste registriert -
#      samt einsatzbereitem Uninstall-Skript.
#   4. Der Anwender sieht ein kaputtes Plugin und deinstalliert es.
#   5. ERST JETZT laeuft dieses Skript - und riss bislang die Docker-Engine
#      mitsamt allen fremden Containern weg.
#
# Genau das wurde im LoxBerry-Forum berichtet ("the installation killed the
# audioserver plugin too", gefolgt von "had to restore from a backup").
#
# Warum KEINE automatische Erkennung, ob die Engine noch gebraucht wird:
#
#   - Eine Liste bekannter Docker-Plugins waere immer unvollstaendig. Dass
#     AudioServer4Home Docker mitbringt, wusste vorher niemand; beim naechsten
#     unbekannten Plugin stuende man wieder am selben Punkt.
#   - "Sind noch Container da?" traegt ebenfalls nicht: unmittelbar nach der
#     Installation von AudioServer4Home existiert dessen Container noch gar
#     nicht. Wer in genau diesem Moment Docker NG deinstalliert, saehe null
#     Container, entfernte die Engine - und das andere Plugin waere beim
#     naechsten Start tot.
#
# Eine ungenutzte Docker-Installation kostet nur Plattenplatz. Eine
# faelschlich entfernte zerstoert fremde Dienste. Deshalb bleibt sie stehen,
# und der Anwender bekommt stattdessen die Befehle genannt, um sie bei Bedarf
# selbst zu entfernen - er allein weiss, was sonst noch auf seinem System
# Docker benutzt.
#
# For logging print to STDOUT using <INFO>/<OK>/<WARNING>/<ERROR> tags.

echo "<INFO> Docker NG wird entfernt."

DOCKER_BIN=$(command -v docker 2>/dev/null)

# --- Portainer-Container entfernen (der gehoert uns) ---
#
# Der Containername ist konfigurierbar; er steht in der Plugin-Konfiguration.
# Faellt das Auslesen aus, wird der Standardname verwendet.
PORTAINER_NAME=$(grep -o '"portainer_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
	"$LBHOMEDIR/config/plugins/dockerng/dockerng.json" 2>/dev/null \
	| head -1 | sed 's/.*"\([^"]*\)"$/\1/')
[ -n "$PORTAINER_NAME" ] || PORTAINER_NAME="portainer"

if [ -n "$DOCKER_BIN" ]
then
	echo "<INFO> Entferne den Portainer-Container ($PORTAINER_NAME)..."
	"$DOCKER_BIN" rm --force "$PORTAINER_NAME" > /dev/null 2>&1
	echo "<OK> Portainer-Container entfernt."
else
	echo "<INFO> Docker ist nicht vorhanden - kein Container zu entfernen."
fi

# --- Portainer-Daten entfernen (gehoeren ebenfalls uns) ---
#
# Hier liegen Portainers eigene Einstellungen und Benutzerkonten. Sie sind
# ohne Portainer nutzlos, und das Verzeichnis wird ausschliesslich von diesem
# Plugin angelegt.
if [ -d /opt/portainer ]
then
	rm -rf /opt/portainer
	echo "<OK> Portainer-Daten entfernt."
fi

# --- Die Docker-Engine bleibt bewusst bestehen ---
echo "<INFO> Die Docker-Engine bleibt installiert - andere Plugins koennten"
echo "<INFO> sie ebenfalls verwenden (z.B. AudioServer4Home)."
echo "<INFO> Wer Docker wirklich vollstaendig entfernen will, prueft zuerst"
echo "<INFO> mit 'docker ps -a', ob noch fremde Container vorhanden sind, und"
echo "<INFO> fuehrt dann von Hand aus:"
echo "<INFO>   sudo apt-get purge docker-ce docker-ce-cli containerd.io"
echo "<INFO>   sudo rm -rf /var/lib/docker /var/lib/containerd"

echo "<OK> Docker NG wurde entfernt."

# Exit with Status 0
exit 0
